# ==============================================================================
# MAPLE M3 Environment Configuration Template
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (PostgreSQL + pgvector)
DB_HOST=localhost
DB_PORT=5432
DB_USER=maple_admin
DB_PASSWORD=your_secure_password
DB_NAME=maple_m3

# AI Model Toggle
# true = Use DGX Spark via Ollama (Free, Local, nomic-embed-text, llama3.1:8b)
# false = Use OpenAI (Paid, Cloud, text-embedding-3-small, gpt-4o-mini)
USE_LOCAL_MODEL=true

# OpenAI API Key (Required if USE_LOCAL_MODEL=false)
OPENAI_API_KEY=sk-your-openai-key-here

# Security
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:4200,https://m3.maristchat.com

# ==============================================================================
# DANGER ZONE
# ==============================================================================
# Set to true ONLY if you are toggling USE_LOCAL_MODEL and need to rebuild the
# pgvector schema to match the new model's dimensions (768 vs 1536).
# NEVER set to true in production. Wipes ChatHistory, Documents, and Vectors.
RESET_DB=false